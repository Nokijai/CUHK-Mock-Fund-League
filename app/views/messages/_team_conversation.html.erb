<%# Team chat conversation %>
<%= turbo_stream_from stream_key %>
<div class="terminal-chat-conv-header">
  <button type="button" class="terminal-chat-back-btn" data-action="click->chat#backToTeamList">←</button>
  <span class="terminal-chat-conv-header-icon">👥</span>
  <div class="terminal-chat-conv-header-info">
    <span class="terminal-chat-conv-name"><%= team.name.upcase %></span>
    <span class="terminal-chat-conv-league">📊 <%= league.name %></span>
  </div>
</div>
<div class="terminal-chat-messages" id="chat-messages-<%= stream_key %>" data-chat-target="messagesContainer">
  <% if messages.empty? %>
    <div class="terminal-chat-empty-state">
      <span class="terminal-chat-empty-icon">🤝</span>
      <span>No team messages yet. Coordinate with your team!</span>
    </div>
  <% end %>
  <% messages.each do |msg| %>
    <%= render partial: "messages/message", locals: { message: msg, current_user_id: current_user.id } %>
  <% end %>
</div>
<% if league_ended %>
  <div class="terminal-chat-closed-banner">
    <span>🔒 This league has ended. Team chat is closed.</span>
  </div>
<% else %>
  <form class="terminal-chat-form" data-action="submit->chat#sendMessage" data-chat-target="messageForm" data-channel-type="team" data-team-id="<%= team.id %>">
    <button type="button" class="terminal-chat-emoji-btn" data-action="click->chat#toggleEmojiPicker" title="Emoji">😊</button>
    <button type="button" class="terminal-chat-sticker-btn" data-action="click->chat#toggleStickerPicker" title="Stickers">🎨</button>
    <input type="text" class="terminal-chat-input" placeholder="Message your team..." data-chat-target="messageInput" autocomplete="off" maxlength="2000">
    <button type="submit" class="terminal-chat-send-btn">➤ SEND</button>
  </form>
<% end %>
