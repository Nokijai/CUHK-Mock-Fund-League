<%# Conversation view loaded into chat box %>
<%= turbo_stream_from stream_key %>
<div class="terminal-chat-conv-header">
  <button type="button" class="terminal-chat-back-btn" data-action="click->chat#backToFriendsList">←</button>
  <div class="terminal-chat-conv-friend-avatar"><%= friend.username[0].upcase %></div>
  <div class="terminal-chat-conv-header-info">
    <span class="terminal-chat-conv-name"><%= friend.username.upcase %></span>
    <span class="terminal-chat-conv-status">● Online</span>
  </div>
</div>
<div class="terminal-chat-messages" id="chat-messages-<%= stream_key %>" data-chat-target="messagesContainer">
  <% if messages.empty? %>
    <div class="terminal-chat-empty-state">
      <span class="terminal-chat-empty-icon">👋</span>
      <span>Say hello to <%= friend.username %>!</span>
    </div>
  <% end %>
  <% messages.each do |msg| %>
    <%= render partial: "messages/message", locals: { message: msg, current_user_id: current_user.id } %>
  <% end %>
</div>
<form class="terminal-chat-form" data-action="submit->chat#sendMessage" data-chat-target="messageForm" data-channel-type="individual" data-friend-id="<%= friend.id %>">
  <button type="button" class="terminal-chat-emoji-btn" data-action="click->chat#toggleEmojiPicker" title="Emoji">😊</button>
  <button type="button" class="terminal-chat-sticker-btn" data-action="click->chat#toggleStickerPicker" title="Stickers">🎨</button>
  <input type="text" class="terminal-chat-input" placeholder="Type a message..." data-chat-target="messageInput" autocomplete="off" maxlength="2000">
  <button type="submit" class="terminal-chat-send-btn">➤ SEND</button>
</form>
