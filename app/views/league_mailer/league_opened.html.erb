<!-- Branded league-opened notice; mirrors OTP mail layout for visual consistency. -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0; padding: 28px 0; background-color: #f4f7fb; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #1f2937;">
  <tr>
    <td align="center" style="padding: 0 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 620px; background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; overflow: hidden;">
        <tr>
          <td style="padding: 24px 28px; background: linear-gradient(135deg, #0f172a, #14532d); color: #ffffff;">
            <p style="margin: 0; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.9;">Mock-Fund League</p>
            <h1 style="margin: 8px 0 0; font-size: 22px; line-height: 1.3; font-weight: 700;">Your league is now open</h1>
            <p style="margin: 10px 0 0; font-size: 14px; line-height: 1.5; opacity: 0.95;">
              <span style="display: inline-block; padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,0.15); font-weight: 600; letter-spacing: 0.04em; font-size: 11px; text-transform: uppercase;">Live</span>
              <span style="margin-left: 8px;"><%= @league.name %></span>
            </p>
          </td>
        </tr>
        <tr>
          <td style="padding: 28px;">
            <p style="margin: 0 0 14px; font-size: 15px; line-height: 1.6;">
              Dear <strong><%= @user.username.presence || @user.email %></strong>,
            </p>
            <p style="margin: 0 0 14px; font-size: 15px; line-height: 1.6;">
              The competition window for <strong><%= @league.name %></strong> has started. You can trade within the scheduled times below—good luck, and stay within the league rules shown on the league page.
            </p>
            <% if @league_description_plain.present? %>
              <p style="margin: 0 0 18px; font-size: 14px; line-height: 1.65; color: #374151; padding: 14px 16px; background-color: #f9fafb; border-left: 4px solid #10b981; border-radius: 0 8px 8px 0;">
                <%= @league_description_plain %>
              </p>
            <% end %>

            <%= render "league_fact_sheet" %>

            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 26px 0 6px;">
              <tr>
                <td style="border-radius: 8px; background-color: #0f172a;">
                  <a href="<%= @league_url %>" style="display: inline-block; padding: 12px 22px; font-size: 14px; font-weight: 600; color: #ffffff; text-decoration: none;">Open league page</a>
                </td>
                <td style="width: 12px;"></td>
                <td style="border-radius: 8px; border: 1px solid #cbd5e1;">
                  <a href="<%= @leaderboard_url %>" style="display: inline-block; padding: 12px 22px; font-size: 14px; font-weight: 600; color: #0f172a; text-decoration: none;">View leaderboard</a>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding: 16px 28px 20px; border-top: 1px solid #e5e7eb; background-color: #fafafa;">
            <p style="margin: 0; font-size: 12px; line-height: 1.6; color: #6b7280;">
              This is an automated message from Mock-Fund League. Please do not reply to this email.
            </p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
