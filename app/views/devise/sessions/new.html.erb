<div style="display: flex; align-items: center; justify-content: center; min-height: calc(100vh - 60px); padding: 2rem;">
  <div class="terminal-form-shell terminal-form-shell--narrow" style="width: 100%; max-width: 480px;">
    <div class="terminal-window">
      <div class="terminal-window-title">LOGIN</div>
      <div style="padding: 1.5rem;">
        <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { login_form: true } }) do |f| %>
          <div style="margin-bottom: 1rem;">
            <%= f.label :email, "EMAIL", class: "terminal-label" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "terminal-input", placeholder: "user@example.com" %>
          </div>

          <div style="margin-bottom: 1rem;">
            <%= f.label :password, "PASSWORD", class: "terminal-label" %>
            <%= f.password_field :password, autocomplete: "current-password", class: "terminal-input", placeholder: "Enter your password" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div style="margin-bottom: 1.5rem;">
              <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 12px; color: var(--terminal-text); cursor: pointer;">
                <%= f.check_box :remember_me, style: "cursor: pointer;" %>
                <span>Remember me</span>
              </label>
            </div>
          <% end %>

          <div class="terminal-form-actions" style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--terminal-border);">
            <%= f.button type: "submit", class: "terminal-btn terminal-btn-primary", data: { login_submit: true } do %>
              <span data-login-label>LOG IN</span>
              <span data-login-spinner style="display: none; width: 12px; height: 12px; margin-left: 0.5rem; border: 2px solid currentColor; border-top-color: transparent; border-radius: 50%; vertical-align: middle; animation: login-spinner-rotate 0.8s linear infinite;"></span>
            <% end %>
          </div>
        <% end %>

        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes login-spinner-rotate {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  (function() {
    const form = document.querySelector("form[data-login-form='true']");
    if (!form) return;

    form.addEventListener("submit", function() {
      const submitButton = form.querySelector("[data-login-submit='true']");
      const spinner = form.querySelector("[data-login-spinner]");
      const label = form.querySelector("[data-login-label]");
      if (!submitButton || !spinner || !label) return;

      submitButton.disabled = true;
      label.textContent = "LOGGING IN";
      spinner.style.display = "inline-block";
      submitButton.setAttribute("aria-busy", "true");
    });
  })();
</script>
