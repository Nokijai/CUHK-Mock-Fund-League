<div class="terminal-auth-page">
  <div class="terminal-auth-card">
    <div class="terminal-window">
      <div class="terminal-window-title">REGISTER</div>
      <div class="terminal-auth-body">
        <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>

          <div class="terminal-form-field">
            <%= f.label :username, "USERNAME", class: "terminal-label" %>
            <div class="terminal-form-hint">No spaces allowed</div>
            <%= f.text_field :username, class: "terminal-input", placeholder: "user123" %>
          </div>

          <div class="terminal-form-field">
            <%= f.label :email, "EMAIL", class: "terminal-label" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "terminal-input", placeholder: "user@example.com" %>
          </div>

          <div class="terminal-form-field" data-controller="password-visibility">
            <%= f.label :password, "PASSWORD", class: "terminal-label" %>
            <div class="terminal-form-hint">Must be at least 8 characters with uppercase, lowercase, number, and special character</div>
            <div class="terminal-password-wrap">
              <%= f.password_field :password, autocomplete: "new-password", class: "terminal-input", placeholder: "Enter password", data: { password_visibility_target: "input" } %>
              <button type="button" class="terminal-password-toggle" data-action="password-visibility#toggle" aria-label="Toggle password visibility" aria-pressed="false">
                <span data-password-visibility-target="statusLabel">Show</span>
              </button>
            </div>
          </div>

          <div class="terminal-form-field" data-controller="password-visibility">
            <%= f.label :password_confirmation, "CONFIRM PASSWORD", class: "terminal-label" %>
            <div class="terminal-password-wrap">
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "terminal-input", placeholder: "Re-enter password", data: { password_visibility_target: "input" } %>
              <button type="button" class="terminal-password-toggle" data-action="password-visibility#toggle" aria-label="Toggle password confirmation visibility" aria-pressed="false">
                <span data-password-visibility-target="statusLabel">Show</span>
              </button>
            </div>
          </div>

          <div class="terminal-form-actions">
            <%= f.submit "SIGN UP", class: "terminal-btn terminal-btn-primary" %>
          </div>
        <% end %>

        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
