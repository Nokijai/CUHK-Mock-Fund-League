<div style="display: flex; align-items: center; justify-content: center; min-height: calc(100vh - 60px); padding: 2rem;"
     data-controller="signup-approval-poll"
     data-signup-approval-poll-interval-value="2000">
  <div class="terminal-form-shell terminal-form-shell--narrow" style="width: 100%; max-width: 480px;">
    <div class="terminal-window">
      <div class="terminal-window-title">VERIFY SIGNUP</div>
      <div style="padding: 1.5rem;">
        <% email = defined?(@pending_user) && @pending_user ? @pending_user.email : "your email" %>
        <% resend_wait_seconds = otp_resend_wait_seconds %>
        <p style="font-size: 12px; color: var(--terminal-muted); margin: 0 0 1rem 0;">
          Enter the 6-digit verification code sent to <strong><%= email %></strong> to complete signup.
        </p>

        <%= form_with url: users_signup_otp_authenticate_path, method: :post, local: true, data: { controller: "otp-code", otp_code_length_value: 6 } do |f| %>
          <div style="margin-bottom: 1rem;">
            <%= f.label :otp_code, "VERIFICATION CODE", class: "terminal-label" %>
            <%= f.text_field :otp_code,
                autofocus: true,
                autocomplete: "one-time-code",
                inputmode: "numeric",
                enterkeyhint: "done",
                maxlength: 6,
                pattern: "[0-9]{6}",
                class: "terminal-input",
                placeholder: "123456",
                data: { otp_code_target: "input", action: "input->otp-code#onInput paste->otp-code#onPaste" } %>
          </div>

          <div class="terminal-form-actions" style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--terminal-border);">
            <%= f.submit "VERIFY & COMPLETE SIGNUP", class: "terminal-btn terminal-btn-primary", disabled: true, data: { otp_code_target: "submit" } %>
          </div>
        <% end %>

        <div style="margin-top: 1rem;">
          <%= link_to "Cancel signup", users_cancel_otp_signup_path, style: "color: var(--terminal-muted); text-decoration: none; font-size: 11px;" %>
        </div>

        <div style="margin-top: 0.75rem;"
             data-controller="resend-cooldown"
             data-resend-cooldown-seconds-left-value="<%= resend_wait_seconds %>">
          <%= form_with url: users_resend_signup_otp_path, method: :post, local: true, html: { style: "display: inline-block;" } do %>
            <%= button_tag "Resend verification code",
                type: "submit",
                class: "terminal-btn",
                style: "font-size: 11px; padding: 0.25rem 0.5rem;",
                disabled: resend_wait_seconds.positive?,
                data: {
                  resend_cooldown_target: "button",
                  base_label: "Resend verification code",
                  ready_label: "Resend verification code"
                } %>
          <% end %>

          <div style="margin-top: 0.35rem; font-size: 11px; color: var(--terminal-muted);"
               data-resend-cooldown-target="help"></div>
        </div>
      </div>
    </div>
  </div>
</div>
