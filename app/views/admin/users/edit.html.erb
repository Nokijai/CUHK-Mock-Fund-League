<% content_for :title, "Edit User — Admin" %>
<div class="terminal-page-head">
  <h1 class="terminal-page-title">EDIT USER</h1>
  <div class="terminal-page-meta"><%= @user.email %></div>
</div>

<% if @user.errors.any? %>
  <div class="terminal-admin-error-panel">
    <strong><%= pluralize(@user.errors.count, "error") %> prevented this user from being saved:</strong>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="terminal-window terminal-admin-form-card">
  <%= form_with model: @user, url: admin_user_path(@user), method: :patch, class: "terminal-form" do |f| %>
    <div class="terminal-form-field">
      <%= f.label :username, "USERNAME", class: "terminal-label" %>
      <%= f.text_field :username, class: "terminal-input", required: true %>
    </div>

    <div class="terminal-form-field">
      <%= f.label :email, "EMAIL", class: "terminal-label" %>
      <%= f.email_field :email, class: "terminal-input", required: true %>
    </div>

    <div class="terminal-form-field" data-controller="password-visibility">
      <%= f.label :password, "PASSWORD", class: "terminal-label" %>
      <div class="terminal-password-wrap">
        <%= f.password_field :password, class: "terminal-input", placeholder: "Leave blank to keep current password", data: { password_visibility_target: "input" } %>
        <button type="button" class="terminal-password-toggle" data-action="password-visibility#toggle" aria-label="Toggle password visibility" aria-pressed="false">
          <span data-password-visibility-target="statusLabel">Show</span>
        </button>
      </div>
    </div>

    <div class="terminal-form-field" data-controller="password-visibility">
      <%= f.label :password_confirmation, "CONFIRM PASSWORD", class: "terminal-label" %>
      <div class="terminal-password-wrap">
        <%= f.password_field :password_confirmation, class: "terminal-input", placeholder: "Leave blank to keep current password", data: { password_visibility_target: "input" } %>
        <button type="button" class="terminal-password-toggle" data-action="password-visibility#toggle" aria-label="Toggle password confirmation visibility" aria-pressed="false">
          <span data-password-visibility-target="statusLabel">Show</span>
        </button>
      </div>
    </div>

    <div class="terminal-form-field">
      <%= f.label :role, "ROLE", class: "terminal-label" %>
      <%= f.select :role, User::ROLES.map { |r| [r.titleize, r] }, {}, class: "terminal-input terminal-select" %>
    </div>

    <div class="terminal-form-actions">
      <%= f.submit "UPDATE USER", class: "terminal-btn terminal-btn-primary" %>
      <%= link_to "CANCEL", admin_users_path, class: "terminal-btn" %>
    </div>
  <% end %>
</div>
