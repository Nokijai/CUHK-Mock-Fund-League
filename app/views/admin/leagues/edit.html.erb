<% content_for :title, "Edit League — Admin" %>
<% max_local = "9999-12-31T23:59" %>
<% editable_before_start = @league.start_date.blank? || @league.start_date > Time.current %>
<div class="terminal-page-head">
  <h1 class="terminal-page-title">EDIT LEAGUE</h1>
  <div class="terminal-page-meta"><%= @league.name %></div>
</div>

<% unless editable_before_start %>
  <div class="terminal-admin-error-panel">
    <strong>Editing is locked:</strong>
    <ul>
      <li>League cannot be edited after it has started.</li>
    </ul>
  </div>
<% end %>

<% if @league.team_mode? %>
  <div class="terminal-window" style="max-width: 900px; margin-top: 1rem;">
    <div class="terminal-window-title">TEAM ROSTERS (ADMIN)</div>
    <div style="padding: 0.75rem;">
      <p class="terminal-form-hint">Remove players from teams if needed (e.g., wrong team, moderation).</p>

      <% teams = @league.teams.sort_by(&:id) %>
      <% if teams.empty? %>
        <p class="terminal-form-hint">No teams created for this league yet.</p>
      <% else %>
        <div class="terminal-team-grid">
          <% teams.each do |team| %>
            <div class="terminal-window terminal-team-card">
              <div class="terminal-team-header">
                <div>
                  <strong><%= team.name %></strong>
                  <span class="terminal-muted-cell" style="margin-left: 0.5rem;">(<%= team.team_memberships_count.to_i %>)</span>
                </div>
              </div>
              <div class="terminal-team-members">
                <% memberships = team.team_memberships.sort_by { |m| m.user.username.to_s.downcase } %>
                <% if memberships.empty? %>
                  <p class="terminal-form-hint">No members.</p>
                <% else %>
                  <% memberships.each do |membership| %>
                    <div class="terminal-team-member-row">
                      <span class="terminal-muted-cell">
                        <%= membership.user.username.presence || membership.user.email %>
                        <span style="opacity: 0.7;">(user_id=<%= membership.user_id %>)</span>
                      </span>
                      <%= button_to "REMOVE",
                                    admin_league_team_membership_path(@league, team, membership),
                                    method: :delete,
                                    class: "terminal-btn terminal-btn--small",
                                    data: { turbo_confirm: "Remove this user from the team?" } %>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% if @league.errors.any? %>
  <div class="terminal-admin-error-panel">
    <strong><%= pluralize(@league.errors.count, "error") %> prevented this league from being saved:</strong>
    <ul>
      <% @league.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="terminal-window terminal-admin-form-card">
  <%= form_with model: @league, url: admin_league_path(@league), method: :patch, class: "terminal-form", data: { controller: "team-mode-fields" } do |f| %>
    <div class="terminal-form-field">
      <%= f.label :name, "LEAGUE NAME", class: "terminal-label" %>
      <%= f.text_field :name, class: "terminal-input", required: true %>
    </div>

    <div class="terminal-form-field">
      <%= f.label :description, "DESCRIPTION", class: "terminal-label" %>
      <%= f.text_area :description, class: "terminal-input terminal-textarea", rows: 4 %>
    </div>

    <div class="terminal-form-field">
      <%= f.label :starting_capital, "STARTING CAPITAL ($)", class: "terminal-label" %>
      <% if editable_before_start %>
        <%= f.number_field :starting_capital, class: "terminal-input", required: true, step: "0.01" %>
      <% else %>
        <p class="terminal-form-hint" style="font-size: 13px; color: var(--terminal-text);"><%= number_to_currency(@league.starting_capital, precision: 2) %> (locked)</p>
      <% end %>
    </div>

    <div class="terminal-form-row">
      <div class="terminal-form-field">
        <%= f.label :start_date, "START DATE & TIME", class: "terminal-label" %>
        <%= f.datetime_local_field :start_date, class: "terminal-input", required: true, max: max_local, step: 60, disabled: !editable_before_start %>
      </div>
      <div class="terminal-form-field">
        <%= f.label :end_date, "END DATE & TIME", class: "terminal-label" %>
        <%= f.datetime_local_field :end_date, class: "terminal-input", required: true, max: max_local, step: 60, disabled: !editable_before_start %>
      </div>
    </div>

    <div class="terminal-form-field">
      <%= f.label :max_participants, "MAX PARTICIPANTS (OPTIONAL)", class: "terminal-label" %>
      <% if editable_before_start %>
        <%= f.number_field :max_participants, class: "terminal-input", min: 1, step: 1, placeholder: "e.g., 50" %>
      <% else %>
        <p class="terminal-form-hint">Max participants: <%= @league.max_participants.presence || "Not set" %> (locked)</p>
      <% end %>
    </div>

    <div class="terminal-form-field">
      <%= f.label :handling_fee_proportion, "HANDLING FEE PROPORTION (0.01 = 1%)", class: "terminal-label" %>
      <% if editable_before_start %>
        <%= f.number_field :handling_fee_proportion, class: "terminal-input", min: 0, max: 1, step: "0.0001", placeholder: "e.g., 0.0025" %>
      <% else %>
        <p class="terminal-form-hint">Handling fee: <%= @league.handling_fee_rule_configured? ? number_to_percentage(@league.handling_fee_proportion * 100, precision: 2) : "Not set" %> (locked)</p>
      <% end %>
    </div>

    <div class="terminal-form-field">
      <%= f.label :minimum_final_balance, "MINIMUM FINAL BALANCE (OPTIONAL)", class: "terminal-label" %>
      <% if editable_before_start %>
        <%= f.number_field :minimum_final_balance, class: "terminal-input", min: 0, step: "0.01", placeholder: "e.g., 90000" %>
      <% else %>
        <p class="terminal-form-hint">Minimum final balance: <%= @league.minimum_final_balance.present? ? number_to_currency(@league.minimum_final_balance) : "Not set" %> (locked)</p>
      <% end %>
    </div>

    <div class="terminal-form-field">
      <%= f.label :team_mode, "TEAM MODE", class: "terminal-label" %>
      <% if editable_before_start %>
        <%= f.check_box :team_mode, data: { action: "change->team-mode-fields#toggle", team_mode_fields_target: "toggle" } %>
      <% else %>
        <p class="terminal-form-hint">Team mode: <%= @league.team_mode? ? "Enabled" : "Disabled" %> (locked)</p>
      <% end %>
    </div>

    <div class="terminal-form-row terminal-form-row--team-limits" data-team-mode-fields-target="fields">
      <div class="terminal-form-field">
        <%= f.label :team_min_participants, "TEAM MIN PARTICIPANTS", class: "terminal-label" %>
        <% if editable_before_start %>
          <%= f.number_field :team_min_participants, class: "terminal-input", min: 1, step: 1, placeholder: "e.g., 3" %>
        <% else %>
          <p class="terminal-form-hint">Team min participants: <%= @league.team_min_participants.presence || "Not set" %> (locked)</p>
        <% end %>
      </div>
      <div class="terminal-form-field">
        <%= f.label :team_max_participants, "TEAM MAX PARTICIPANTS", class: "terminal-label" %>
        <% if editable_before_start %>
          <%= f.number_field :team_max_participants, class: "terminal-input", min: 1, step: 1, placeholder: "e.g., 5" %>
        <% else %>
          <p class="terminal-form-hint">Team max participants: <%= @league.team_max_participants.presence || "Not set" %> (locked)</p>
        <% end %>
      </div>
    </div>

    <div class="terminal-form-actions">
      <%= f.submit "UPDATE LEAGUE", class: "terminal-btn terminal-btn-primary", disabled: !editable_before_start %>
      <%= link_to "CANCEL", admin_leagues_path, class: "terminal-btn" %>
    </div>
  <% end %>
</div>
