<% content_for :title, "Edit League — Admin" %>
<div class="terminal-page-head">
  <h1 class="terminal-page-title">EDIT LEAGUE</h1>
  <div class="terminal-page-meta"><%= @league.name %></div>
</div>

<%# Team roster management: admins can remove users from teams for a league. %>
<% if @league.team_mode? %>
  <div class="terminal-window" style="max-width: 900px; margin-top: 1rem;">
    <div class="terminal-stat-label">TEAM ROSTERS (ADMIN)</div>
    <p class="terminal-page-meta" style="margin-top: 0.25rem;">
      Remove players from teams if needed (e.g., wrong team, moderation).
    </p>

    <% teams = @league.teams.sort_by(&:id) %>
    <% if teams.empty? %>
      <p class="terminal-page-meta" style="margin: 0;">No teams created for this league yet.</p>
    <% else %>
      <div style="display:grid; grid-template-columns: 1fr; gap: 0.75rem; margin-top: 0.65rem;">
        <% teams.each do |team| %>
          <div class="terminal-window" style="padding: 0.75rem 0.85rem;">
            <div style="display:flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; justify-content: space-between;">
              <div>
                <strong><%= team.name %></strong>
                <span class="terminal-page-meta" style="margin-left: 0.5rem;">(<%= team.team_memberships_count.to_i %>)</span>
              </div>
            </div>

            <div style="margin-top: 0.6rem;">
              <% memberships = team.team_memberships.sort_by { |m| m.user.username.to_s.downcase } %>
              <% if memberships.empty? %>
                <p class="terminal-page-meta" style="margin: 0;">No members.</p>
              <% else %>
                <div style="display:flex; flex-direction: column; gap: 0.5rem;">
                  <% memberships.each do |membership| %>
                    <div style="display:flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; justify-content: space-between;">
                      <div class="terminal-page-meta" style="margin: 0;">
                        <%= membership.user.username.presence || membership.user.email %>
                        <span style="opacity: 0.7;">(user_id=<%= membership.user_id %>)</span>
                      </div>
                      <%= button_to "REMOVE",
                                    admin_league_team_membership_path(@league, team, membership),
                                    method: :delete,
                                    class: "terminal-btn",
                                    data: { turbo_confirm: "Remove this user from the team?" } %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<% if @league.errors.any? %>
  <div class="terminal-window" style="max-width: 600px; background: rgba(255, 50, 50, 0.1); border-left: 4px solid var(--terminal-down);">
    <div style="color: var(--terminal-down); font-weight: bold; margin-bottom: 0.5rem;">
      ⚠️ <%= pluralize(@league.errors.count, "error") %> prevented this league from being saved:
    </div>
    <ul style="margin: 0.5rem 0 0 1.5rem; line-height: 1.8; color: var(--terminal-text);">
      <% @league.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="terminal-window" style="max-width: 600px;">
  <%= form_with model: @league, url: admin_league_path(@league), method: :patch, class: "terminal-form" do |f| %>

    <div class="terminal-form-field">
      <%= f.label :name, "LEAGUE NAME" %>
      <%= f.text_field :name, class: "terminal-input", required: true %>
    </div>

    <div class="terminal-form-field">
      <%= f.label :description, "DESCRIPTION" %>
      <%= f.text_area :description, class: "terminal-input", rows: 4 %>
    </div>

    <%# Starting capital is set once at create (portfolios use it); not editable here. %>
    <div class="terminal-form-field">
      <div class="terminal-label" style="margin-bottom: 0.35rem;">STARTING CAPITAL (LOCKED AFTER CREATION)</div>
      <p class="terminal-page-meta" style="margin: 0;"><%= number_to_currency(@league.starting_capital, precision: 2) %></p>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
      <div class="terminal-form-field">
        <%= f.label :start_date, "START DATE & TIME" %>
        <%= f.datetime_local_field :start_date, class: "terminal-input", required: true %>
      </div>

      <div class="terminal-form-field">
        <%= f.label :end_date, "END DATE & TIME" %>
        <%= f.datetime_local_field :end_date, class: "terminal-input", required: true %>
      </div>
    </div>

    <%# Rules are persisted in leagues.rules only at create; edit is read-only for fairness. %>
    <div class="terminal-form-field">
      <div class="terminal-label" style="margin-bottom: 0.35rem;">RULES (LOCKED AFTER CREATION)</div>
      <% if @league.rules.present? %>
        <p class="terminal-page-meta" style="margin: 0;">
          <% rendered_rule_line = false %>
          <% if @league.max_participants.present? %>
            Max participants: <%= @league.max_participants %><br>
            <% rendered_rule_line = true %>
          <% end %>
          <% if @league.handling_fee_rule_configured? %>
            Handling fee: <%= number_to_percentage(@league.handling_fee_proportion * 100, precision: 2) %><br>
            <% rendered_rule_line = true %>
          <% end %>
          <% if @league.minimum_final_balance.present? %>
            Minimum final balance: <%= number_to_currency(@league.minimum_final_balance) %>
            <% rendered_rule_line = true %>
          <% end %>
          <% unless rendered_rule_line %>
            <%= @league.rules.is_a?(Hash) ? @league.rules.to_json : @league.rules %>
          <% end %>
        </p>
      <% else %>
        <p class="terminal-page-meta" style="margin: 0;">No league-specific rules stored.</p>
      <% end %>
    </div>

    <div style="display: flex; gap: 1rem; margin-top: 2rem;">
      <%= f.submit "UPDATE LEAGUE", class: "terminal-btn terminal-btn-primary", style: "color: var(--terminal-bg);" %>
      <%= link_to "CANCEL", admin_leagues_path, class: "terminal-btn" %>
    </div>
  <% end %>
</div>
