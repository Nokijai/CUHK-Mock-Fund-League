<div class="terminal-window terminal-search-box">
  <div class="terminal-search-wrap">
    <%= text_field_tag :search, params[:search],
        class: "terminal-input",
        placeholder: search_placeholder,
        id: "searchInput",
        style: "padding-right: 2.5rem;",
        oninput: "performSearch(this.value)" %>
    <button onclick="clearSearch()"
            id="clearBtn"
            class="terminal-search-clear"
            type="button"
            style="<%= params[:search].present? ? '' : 'display: none;' %>"
            aria-label="Clear search">
      &times;
    </button>
  </div>
</div>

<%= javascript_tag nonce: true do %>
  var searchTimeout;
  var searchEndpoint = '<%= search_endpoint %>';
  var searchTargetSelector = '<%= local_assigns[:search_target_selector].presence || ".terminal-window table" %>';

  function performSearch(query) {
    var clearBtn = document.getElementById('clearBtn');
    clearBtn.style.display = query ? 'block' : 'none';

    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(function() {
      fetch(searchEndpoint + '?search=' + encodeURIComponent(query), {
        headers: { 'Accept': 'text/html', 'X-Requested-With': 'XMLHttpRequest' }
      })
      .then(function(r) { return r.text(); })
      .then(function(html) {
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
        var newTarget = doc.querySelector(searchTargetSelector);
        var oldTarget = document.querySelector(searchTargetSelector);
        if (newTarget && oldTarget) {
          oldTarget.outerHTML = newTarget.outerHTML;
        }
      });
    }, 150);
  }

  function clearSearch() {
    document.getElementById('searchInput').value = '';
    document.getElementById('clearBtn').style.display = 'none';
    performSearch('');
  }
<% end %>
