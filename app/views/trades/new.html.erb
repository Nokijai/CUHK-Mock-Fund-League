<% content_for :title, "Trading — MOCK-FUND" %>
<div class="terminal-page-head">
  <h1 class="terminal-page-title">NEW TRADE</h1>
  <div class="terminal-page-meta"><%= @portfolio.user&.name %> · <%= @portfolio.league&.name %> · Cash <%= number_to_currency(@portfolio.cash_balance, precision: 2) %></div>
</div>
<%# Full quote strip when a ticker is focused: USE link, single search hit, or form symbol after validation. %>
<% if @focus_symbol.present? %>
  <%= render "trading_quote_panel" %>
<% end %>
<div class="terminal-trading-grid">
  <div class="terminal-form-shell terminal-form-shell--narrow">
    <%= render "trade_form", trade: @trade, portfolio: @portfolio %>
  </div>
  <div class="terminal-window terminal-available-stocks">
    <div class="terminal-window-title">AVAILABLE STOCKS</div>
    <p class="terminal-stocks-hint">Reference prices · USE fills the order · filter to one ticker (or USE) for quote + chart · 1H / 4H / 1D switch timeframe</p>
    <%# GET filter; same DB substring search as GET /stocks/search (Nestak universe). %>
    <%= form_with url: new_portfolio_trade_path(@portfolio), method: :get, local: true, class: "terminal-toolbar" do %>
      <%= hidden_field_tag :quote_interval, params[:quote_interval] if params[:quote_interval].present? %>
      <%= label_tag :q, "SEARCH TICKERS", class: "terminal-label" %>
      <%= text_field_tag :q, params[:q], class: "terminal-input", placeholder: "Symbol…", autocomplete: "off" %>
      <%= submit_tag "FILTER", class: "terminal-btn" %>
      <% if params[:q].present? %>
        <%= link_to "CLEAR", new_portfolio_trade_path(@portfolio), class: "terminal-btn" %>
      <% end %>
    <% end %>
    <div class="terminal-stocks-scroll">
      <table class="terminal-table terminal-table-compact">
        <thead>
          <tr>
            <th>SYM</th>
            <th>NAME</th>
            <th class="num">LAST</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if @available_stocks.any? %>
            <% @available_stocks.each do |sp| %>
              <% use_params = { prefill_symbol: sp.symbol, prefill_price: sp.price } %>
              <% use_params[:q] = params[:q] if params[:q].present? %>
              <% use_params[:quote_interval] = params[:quote_interval] if params[:quote_interval].present? %>
              <tr>
                <td><strong><%= sp.symbol %></strong></td>
                <td class="terminal-ellipsis terminal-stock-name"><%= stock_name_for(sp.symbol) %></td>
                <td class="num"><%= number_to_currency(sp.price, precision: 2) %></td>
                <td class="terminal-stock-use">
                  <%= link_to "USE", new_portfolio_trade_path(@portfolio, use_params), class: "terminal-link-use" %>
                </td>
              </tr>
            <% end %>
          <% elsif params[:q].present? %>
            <tr>
              <td colspan="4" class="terminal-muted-cell">
                No tickers match &ldquo;<%= h params[:q] %>&rdquo;.
                <%= link_to "Clear search", new_portfolio_trade_path(@portfolio), class: "terminal-dash-link" %>
              </td>
            </tr>
          <% else %>
            <tr>
              <td colspan="4" class="terminal-muted-cell">No quotes loaded. Run <code>bin/rails db:seed</code>.</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
