<% latest_market_price = @focus_stock&.price&.to_d || trade.price&.to_d %>
<%= form_with model: [ portfolio, trade ],
  class: "terminal-form",
  data: {
    controller: "order-form",
    order_form_market_price_value: latest_market_price&.to_f
  } do |f| %>
  <%# Keep selected league context in URL after submit/re-render. %>
  <%= hidden_field_tag :league_id, portfolio.league_id %>
  <%# Keep ticker search filter after a failed submit (matches assign_available_stocks). %>
  <%= hidden_field_tag :q, params[:q] if params[:q].present? %>
  <%# Preserve selected chart interval when re-rendering after validation errors. %>
  <%= hidden_field_tag :quote_interval, @quote_interval if defined?(@quote_interval) && @quote_interval.present? %>
  <%= render "shared/errors", object: trade %>
  <div class="terminal-form-grid">
    <div class="terminal-field">
      <%= f.label :symbol, "SYMBOL", class: "terminal-label" %>
      <%= f.text_field :symbol, class: "terminal-input", placeholder: "AAPL", required: true %>
    </div>
    <div class="terminal-field">
      <%= f.label :trade_type, "SIDE", class: "terminal-label" %>
      <%= f.select :trade_type, %w[buy sell], {}, class: "terminal-input terminal-select" %>
    </div>
    <div class="terminal-field">
      <%= f.label :order_type, "ORDER TYPE", class: "terminal-label" %>
      <%= f.select :order_type,
        [["Market", "market"], ["Limit", "limit"]],
        {},
        class: "terminal-input terminal-select",
        data: { order_form_target: "orderType", action: "change->order-form#onOrderTypeChange" } %>
    </div>
    <div class="terminal-field">
      <%= f.label :quantity, "QUANTITY", class: "terminal-label" %>
      <%= f.number_field :quantity, class: "terminal-input", min: 1, required: true %>
    </div>
    <div class="terminal-field">
      <%= f.label :price, "PRICE", class: "terminal-label" %>
      <%= f.number_field :price,
        class: "terminal-input",
        step: 0.01,
        min: 0.01,
        required: true,
        data: { order_form_target: "price" } %>
    </div>
  </div>
  <div class="terminal-form-actions">
    <%= f.submit "SUBMIT ORDER", class: "terminal-btn terminal-btn-primary" %>
    <%= link_to "BACK TO PORTFOLIO", portfolio_path(portfolio, league_id: portfolio.league_id), class: "terminal-btn" %>
  </div>
<% end %>
