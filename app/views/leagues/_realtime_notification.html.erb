<%# Turbo Stream insert: one card per notification; Stimulus handles timed dismiss vs close-only. %>
<% notification_id = local_assigns[:notification_id].presence || "realtime-notif-#{league.id}-#{SecureRandom.hex(4)}" %>
<% auto_dismiss_ms = local_assigns.fetch(:auto_dismiss_ms, 0).to_i %>
<% tone = local_assigns.fetch(:tone, :accent).to_sym %>
<%# :created = persistent until ×; member notices use auto_dismiss_ms (10s) + ×. %>
<div
  id="<%= notification_id %>"
  class="terminal-realtime-notif-card terminal-realtime-notif-card--<%= tone %> <%= "terminal-realtime-notif-card--persistent" if auto_dismiss_ms <= 0 %>"
  data-controller="realtime-notification"
  data-realtime-notification-auto-dismiss-ms-value="<%= auto_dismiss_ms %>"
  role="status"
>
  <div class="terminal-realtime-notif-main">
    <div class="terminal-realtime-notif-title"><%= title.presence || "League notice" %></div>
    <div class="terminal-realtime-notif-body"><%= body.presence || league.name %></div>
    <%# Navigation only — does not dismiss the toast (dismiss is × only, per product rules). %>
    <%= link_to "View league", leagues_path(anchor: "league-#{league.id}"), class: "terminal-realtime-notif-view" %>
  </div>
  <button
    type="button"
    class="terminal-realtime-notif-close"
    data-action="realtime-notification#dismiss"
    aria-label="Dismiss notification"
  >&times;</button>
</div>
