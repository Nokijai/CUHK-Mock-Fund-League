<% content_for :title, "Leagues — MOCK-FUND" %>
<div class="terminal-page-head terminal-page-head--row">
  <div>
    <h1 class="terminal-page-title">LEAGUES</h1>
    <div class="terminal-page-meta">Click a league to expand details, then join from the same page.</div>
  </div>
  <%# CREATE LEAGUE action intentionally disabled on /leagues page; use admin manage pages instead. %>
</div>

<%# data-controller: open the league card that matches #league-<id> so each league’s rules block is visible after redirect/deep link. %>
<div class="terminal-league-cards" data-controller="leagues-deep-link">
  <% @leagues.each do |league| %>
    <% membership = @membership_by_league_id[league.id] %>
    <% team_membership = @team_membership_by_league_id[league.id] %>
    <%# Use SQL-counted value from controller to avoid loading membership rows. %>
    <% member_count = league.respond_to?(:memberships_count) ? league.memberships_count : league.league_memberships.size %>
    <details class="terminal-window terminal-league-card" id="league-<%= league.id %>">
      <summary class="terminal-league-card-summary">
        <div class="terminal-league-summary-main">
          <strong><%= league.name %></strong>
          <% if membership %>
            <span class="terminal-badge-active">JOINED</span>
          <% end %>
        </div>
        <div class="terminal-league-summary-meta">
          <span><%= number_to_currency(league.starting_capital, precision: 0) %></span>
          <span><%= format_datetime(league.start_date, format: :short) %> → <%= format_datetime(league.end_date, format: :short) %></span>
        </div>
      </summary>

      <%# Expanded top-down info panel for each league; replaces the old show-page detail view. %>
      <div class="terminal-league-card-body">
        <div class="terminal-stats-row terminal-stats-row--tight">
          <div class="terminal-stat-card">
            <div class="terminal-stat-label">STARTING CAPITAL</div>
            <div class="terminal-stat-value"><%= number_to_currency(league.starting_capital, precision: 0) %></div>
          </div>
          <div class="terminal-stat-card">
            <div class="terminal-stat-label">SCHEDULE</div>
            <div class="terminal-stat-value terminal-stat-small"><%= format_datetime(league.start_date, format: :short) %> → <%= format_datetime(league.end_date, format: :short) %></div>
          </div>
          <div class="terminal-stat-card">
            <div class="terminal-stat-label">MEMBERS</div>
            <div class="terminal-stat-value terminal-stat-small"><%= member_count %></div>
          </div>
        </div>

        <div class="terminal-league-details">
          <div class="terminal-stat-label">DESCRIPTION</div>
          <p class="terminal-page-meta"><%= league.description.presence || "No description provided." %></p>
          <% if league.rules.present? %>
            <div class="terminal-stat-label">RULES</div>
            <%# Show admin-configured rule fields with labels instead of raw JSON. %>
            <p class="terminal-page-meta">
              <% rendered_rule_line = false %>
              <% if league.max_participants.present? %>
                Max participants: <%= league.max_participants %><br>
                <% rendered_rule_line = true %>
              <% end %>
              <%# Include 0% when the key exists in leagues.rules (virtual attr defaults to 0 when key absent). %>
              <% if league.handling_fee_rule_configured? %>
                Handling fee: <%= number_to_percentage(league.handling_fee_proportion * 100, precision: 2) %><br>
                <% rendered_rule_line = true %>
              <% end %>
              <% if league.minimum_final_balance.present? %>
                Minimum final balance: <%= number_to_currency(league.minimum_final_balance) %>
                <% rendered_rule_line = true %>
              <% end %>
              <% unless rendered_rule_line %>
                <%= league.rules.is_a?(Hash) ? league.rules.to_json : league.rules %>
              <% end %>
            </p>
          <% end %>
        </div>

        <% if league.team_mode? %>
          <%# Turbo frame keeps the league card open: join/create updates this section only. %>
          <%= turbo_frame_tag "league-teams-#{league.id}" do %>
            <%= render "leagues/team_mode_panel", league: league, team_membership: team_membership %>
          <% end %>
        <% end %>

        <div class="terminal-toolbar">
          <% if membership %>
            <span class="terminal-btn terminal-btn-disabled">JOINED</span>
            <%# Quit league: same cleanup as LeagueMembershipsController#destroy (portfolio + team seat + membership). %>
            <%= button_to "LEAVE LEAGUE",
              league_membership_path(membership),
              method: :delete,
              class: "terminal-btn",
              form: { data: { turbo_confirm: "Leave \"#{league.name}\"? Your portfolio and team membership in this league will be removed." } } %>
          <% elsif !league.join_open_now? %>
            <%# Mirror backend join window rules directly in list action states. %>
            <span class="terminal-btn terminal-btn-disabled">
              <%= league.join_block_reason == :not_opened ? "NOT OPEN YET" : "EXPIRED" %>
            </span>
          <% elsif league.full_for_new_members? %>
            <%# Show capacity lock state so users understand why join is unavailable. %>
            <span class="terminal-btn terminal-btn-disabled">LEAGUE FULL</span>
          <% elsif league.team_mode? %>
            <%# Team-mode leagues are joined via a team selection above. %>
            <span class="terminal-btn terminal-btn-disabled">JOIN VIA TEAM ABOVE</span>
          <% else %>
            <%# Join action lives on /leagues so users do not need a separate show page. %>
            <%= button_to "JOIN LEAGUE",
              league_memberships_path(league_membership: { league_id: league.id }),
              method: :post,
              class: "terminal-btn terminal-btn-primary" %>
          <% end %>
          <%= link_to "LEADERBOARD", leaderboard_path, class: "terminal-btn terminal-btn-primary" %>
          <%# EDIT action intentionally disabled on /leagues page; use admin manage pages instead. %>
        </div>
      </div>
    </details>
  <% end %>
</div>

<div class="terminal-window">
  <% if @leagues.empty? %>
    <% if current_user.admin? %>
      <p class="terminal-empty">No leagues. <%= link_to "Create one", new_league_path %>.</p>
    <% else %>
      <p class="terminal-empty">No leagues available.</p>
    <% end %>
  <% end %>
</div>
