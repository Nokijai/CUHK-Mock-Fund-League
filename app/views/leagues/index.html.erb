<% content_for :title, "Leagues — MOCK-FUND" %>
<div class="terminal-page-head terminal-page-head--row">
  <div>
    <h1 class="terminal-page-title">LEAGUES</h1>
    <div class="terminal-page-meta">Click a league to expand details, then register from the same page.</div>
  </div>
  <%# CREATE LEAGUE action intentionally disabled on /leagues page; use admin manage pages instead. %>
</div>

<div class="terminal-section" data-controller="leagues-smart-refresh">
  <div class="terminal-window" style="margin-bottom: 1rem;">
    <div class="terminal-window-title">CURRENT / UPCOMING LEAGUES</div>
    <%= render "leagues/current_upcoming_results" %>
  </div>

  <div class="terminal-window" style="margin-bottom: 1rem;">
    <div class="terminal-window-title">PAST LEAGUES</div>
    <%= render "admin/shared/search_box", search_placeholder: "Search past leagues...", search_endpoint: leagues_path, search_target_selector: "#past-leagues-results" %>

    <%= render "leagues/past_results" %>
  </div>
</div>
