# Copy this file to .env and fill in values for your environment.
# Do not commit real secrets.

# -----------------------------------------------------------------------------
# Docker / PostgreSQL (used by docker-compose)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mock_fund_league_development
WEB_PORT=3000

# -----------------------------------------------------------------------------
# Rails runtime
# -----------------------------------------------------------------------------
RAILS_ENV=development
SECRET_KEY_BASE=
# Required in production (local dev usually uses credentials file)
RAILS_MASTER_KEY=
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
PORT=3000
RAILS_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database URLs (used by app/web/jobs in docker-compose)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@db:5432/mock_fund_league_development
QUEUE_DATABASE_URL=postgresql://postgres:postgres@db:5432/mock_fund_league_development
CACHE_DATABASE_URL=postgresql://postgres:postgres@db:5432/mock_fund_league_development
CABLE_DATABASE_URL=postgresql://postgres:postgres@db:5432/mock_fund_league_development

# Optional local PG overrides (when not using DATABASE_URL directly)
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGHOST_TEST=localhost

# -----------------------------------------------------------------------------
# Jobs / queue behavior
# -----------------------------------------------------------------------------
JOB_CONCURRENCY=3
SOLID_QUEUE_IN_PUMA=0
PIDFILE=

# -----------------------------------------------------------------------------
# Market data integration
# -----------------------------------------------------------------------------
MARKET_DATA_PYTHON_BIN=/opt/market-data-venv/bin/python
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_INSECURE_SSL=false
FINNHUB_API_KEY=

# -----------------------------------------------------------------------------
# OAuth (Devise Omniauth)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Mailer (development + production SMTP)
# For dev file-delivery, keep REAL_EMAIL_DELIVERY=false
# -----------------------------------------------------------------------------
REAL_EMAIL_DELIVERY=false
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=gmail.com
SMTP_AUTH=plain
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Production mail URL helpers
APP_HOST=localhost
APP_PROTOCOL=http

# -----------------------------------------------------------------------------
# Admin/bootstrap tasks (set only when running those tasks)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
ADMIN_BOOTSTRAP_RELAX_PASSWORD_POLICY=0
CONFIRM_DB_PURGE=0
CLEAR_SOLID_QUEUE=0

# -----------------------------------------------------------------------------
# Test/CI
# -----------------------------------------------------------------------------
CI=false
ALLOW_DATABASE_URL_IN_TEST=false
CUCUMBER_FORMAT=pretty
