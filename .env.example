# Database
postgresql://postgres:postgres@localhost:5432/cuhk_mock_fund_league_development

# Stock API (Alpha Vantage)
# ALPHA_VANTAGE_API_KEY=your_api_key_here

# Stock API (Yahoo Finance - if used)
# No API key required for basic usage

# Rails
# RAILS_ENV=development
# SECRET_KEY_BASE=your_secret_key

# Email delivery (development)
# Leave REAL_EMAIL_DELIVERY unset or false to save mails in tmp/mails.
# REAL_EMAIL_DELIVERY=true
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_DOMAIN=gmail.com
# SMTP_AUTH=plain
# SMTP_STARTTLS=true
# SMTP_USERNAME=your_gmail_address@gmail.com
# SMTP_PASSWORD=your_gmail_app_password

# Solid Queue (production): run `bin/jobs` alongside the app, or set SOLID_QUEUE_IN_PUMA=1 to run inside Puma.
# Ensure queue DB tables exist: `bin/rails db:schema:load:queue` (or `db:prepare`) after deploy.

# One-time admin (never commit real values): pass on the shell, not in this file.
#   CONFIRM_DB_PURGE=1 [CLEAR_SOLID_QUEUE=1] bin/rails db:purge_application_data
#   ADMIN_EMAIL=... ADMIN_PASSWORD=... bin/rails admin:bootstrap
# If password does not meet User complexity rules, use once: ADMIN_BOOTSTRAP_RELAX_PASSWORD_POLICY=1
